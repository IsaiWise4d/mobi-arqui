---
import { servicios } from '../data/sitio';
const items = servicios.map((s) => `${s.codigo} ${s.area}`);
---

<div class="service-ribbon" aria-label="Servicios de Mobi Arquitectura">
  <div class="service-ribbon-track">
    {
      [0, 1, 2, 3].map((set) => (
        <div class="service-ribbon-set" aria-hidden={set > 0 ? 'true' : undefined}>
          {items.map((item) => (
            <>
              <span>{item}</span>
              <i />
            </>
          ))}
        </div>
      ))
    }
  </div>
</div>
