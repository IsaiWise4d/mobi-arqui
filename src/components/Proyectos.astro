---
import { proyectos, marca } from '../data/sitio';
---

<section class="sec proyectos-section proyectos-section--blueprint" id="proyectos" aria-labelledby="proyectos-title">
  <div class="wrap">
    <div class="sec-head reveal" data-gsap="section-head">
      <p class="section-index">04 / PROYECTOS</p>
      <h2 class="sec-title" id="proyectos-title">Obra real,<br /><span>en Barranquilla.</span></h2>
      <p class="proyectos-intro">Diseño, obra civil y carpintería para hogares y también para constructoras aliadas.</p>
    </div>

    <div class="embla ficha-carousel reveal" data-carousel data-carousel-fichas data-carousel-manual aria-roledescription="carrusel" aria-label="Proyectos de Mobi Arquitectura">
      <div class="embla__viewport">
        <div class="embla__container ficha-rail">
          {
            proyectos.map((p, i) => (
              <article
                class="ficha ficha-slide"
                aria-roledescription="diapositiva"
                aria-label={`${i + 1} de ${proyectos.length}`}
              >
                <div class="ficha-data">
                  <p class="row-code">{p.categoria.toUpperCase()} · FICHA {String(i + 1).padStart(2, '0')}</p>
                  <h3>{p.titulo}</h3>
                  <dl class="ficha-table">
                    <div><dt>Cliente</dt><dd>{p.cliente}</dd></div>
                    <div><dt>Categoría</dt><dd>{p.categoria}</dd></div>
                    <div><dt>Año</dt><dd>{p.anio}</dd></div>
                  </dl>
                  <p class="ficha-desc">{p.descripcion}</p>
                </div>
                <div class="ficha-media">
                  {
                    p.fotos.length > 0 ? (
                      <div class="ficha-gallery" data-gallery>
                        <div class="ficha-main">
                          <img src={p.fotos[0].src} alt={p.fotos[0].alt} loading="lazy" data-gallery-main />
                          <p class="ficha-count">
                            <span data-gallery-index>01</span> / {String(p.fotos.length).padStart(2, '0')}
                          </p>
                        </div>
                        <div class="ficha-thumbs" role="tablist" aria-label={`Fotos de ${p.titulo}`}>
                          {p.fotos.map((f, j) => (
                            <button
                              type="button"
                              class={`ficha-thumb${j === 0 ? ' is-active' : ''}`}
                              data-gallery-thumb={j}
                              data-src={f.src}
                              data-alt={f.alt}
                              aria-label={`Ver foto ${j + 1}: ${f.alt}`}
                            >
                              <img src={f.src} alt="" aria-hidden="true" loading="lazy" />
                            </button>
                          ))}
                        </div>
                      </div>
                    ) : (
                      <div class="plot ficha-plot" data-gsap="plot">
                        <p class="plot-coord tl">0,0</p>
                        <p class="plot-coord tr">16,0</p>
                        <p class="plot-coord bl">0,9</p>
                        <p class="plot-coord br">16,9</p>
                        <div class="plot-crosshair" aria-hidden="true" />
                        <p class="stamp">Galería en levantamiento</p>
                      </div>
                    )
                  }
                </div>
              </article>
            ))
          }
        </div>
      </div>
      <div class="carousel-controls ficha-controls">
        <button class="carousel-button" type="button" data-carousel-prev aria-label="Proyecto anterior">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5-7 7 7 7M8 12h10" /></svg>
        </button>
        <div class="carousel-progress" aria-hidden="true"><span></span></div>
        <p class="carousel-count"><span data-carousel-current>01</span> / {String(proyectos.length).padStart(2, '0')}</p>
        <button class="carousel-button" type="button" data-carousel-next aria-label="Siguiente proyecto">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 5l7 7-7 7M16 12H6" /></svg>
        </button>
      </div>
    </div>

    <p class="plot-note reveal">
      Seguimos documentando más obras — mientras tanto, así trabajamos con las constructoras y hogares que confían en
      Mobi. <a class="text-link" href={marca.instagram} target="_blank" rel="noopener">Ver {marca.instagramHandle} <span aria-hidden="true">↗</span></a>
    </p>
  </div>
</section>

<script>
  document.querySelectorAll('[data-gallery]').forEach((gallery) => {
    const main = gallery.querySelector('[data-gallery-main]');
    const indexLabel = gallery.querySelector('[data-gallery-index]');
    const thumbs = [...gallery.querySelectorAll('[data-gallery-thumb]')];
    if (!main || !thumbs.length) return;
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const src = thumb.getAttribute('data-src');
        const alt = thumb.getAttribute('data-alt') || main.getAttribute('alt') || '';
        if (!src || main.getAttribute('src') === src) return;
        main.style.opacity = '0';
        const swap = () => {
          main.setAttribute('src', src);
          main.setAttribute('alt', alt);
          main.style.opacity = '1';
        };
        setTimeout(swap, 140);
        thumbs.forEach((t) => t.classList.remove('is-active'));
        thumb.classList.add('is-active');
        const i = Number(thumb.getAttribute('data-gallery-thumb')) + 1;
        if (indexLabel) indexLabel.textContent = String(i).padStart(2, '0');
      });
    });
  });
</script>
