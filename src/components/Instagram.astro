---
import { marca, instagramPosts } from '../data/sitio';

const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="sec instagram-section instagram-section--night" aria-labelledby="instagram-title">
  <div class="wrap instagram-layout">
    <div class="instagram-copy reveal" data-motion="section-head">
      <p class="section-index">05 / DETRÁS DEL PLANO</p>
      <h2 class="sec-title" id="instagram-title">El taller,<br /><span>en vivo.</span></h2>
      <p>Ideas, materiales y espacios en proceso. Conoce el día a día de Mobi antes de que el plano llegue a tu casa.</p>
      <a class="sello instagram-cta" href={marca.instagram} target="_blank" rel="noopener">Seguir en Instagram <span aria-hidden="true">↗</span></a>
    </div>

    <div
      class="ig-sheet-wrap"
      data-snap-carousel
      aria-roledescription="carrusel"
      aria-label={`Reels de ${marca.instagramHandle}`}
    >
      <p class="ig-note ig-note--top" aria-hidden="true">REGISTRO DE OBRA · {pad(instagramPosts.length)} REELS</p>
      <ul class="ig-sheet" data-snap-viewport>
        {
          instagramPosts.map((post, i) => (
            <li
              class="ig-cell"
              data-snap-slide
              aria-roledescription="diapositiva"
              aria-label={`${i + 1} de ${instagramPosts.length}`}
            >
              <a class="ig-card" href={post.url} target="_blank" rel="noopener">
                <span class="ig-frame">
                  <img src={post.foto} alt={post.alt} width={post.ancho} height={post.alto} loading="lazy" decoding="async" />
                  <span class="ig-code" aria-hidden="true">IG-{pad(i + 1)}</span>
                  <span class="ig-kind" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5-11-6.5Z" /></svg>
                    Reel
                  </span>
                </span>
                <span class="ig-label">
                  <span><span class="sr-only">Ver reel en Instagram: </span>{post.etiqueta}</span>
                  <span class="ig-arrow" aria-hidden="true">↗</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <!-- Controls show only in the mobile carousel (≤760px), like the other carousels. -->
      <div class="carousel-controls ig-controls">
        <button class="carousel-button" type="button" data-snap-prev aria-label="Reel anterior">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5-7 7 7 7M8 12h10" /></svg>
        </button>
        <div class="carousel-progress" aria-hidden="true"><span></span></div>
        <p class="carousel-count"><span data-snap-current>01</span> / {pad(instagramPosts.length)}</p>
        <button class="carousel-button" type="button" data-snap-next aria-label="Siguiente reel">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 5l7 7-7 7M16 12H6" /></svg>
        </button>
      </div>
      <p class="ig-note ig-note--bottom" aria-hidden="true">{marca.instagramHandle.toUpperCase()}</p>
    </div>
  </div>
</section>
