---
import { waLink, marca } from '../data/sitio';
---

<section class="sec contact-section" id="contacto" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="contact-panel reveal" data-gsap="contact">
      <p class="section-index">SIGUIENTE TRAZO</p>
      <h2 class="contact-title" id="contact-title">¿Tienes un<br /><em>proyecto</em> en mente?</h2>
      <p class="contact-line">Barranquilla, Colombia · WhatsApp directo, sin formularios</p>
      <div class="contact-actions">
        <a class="sello sello-big" href={waLink()} target="_blank" rel="noopener">Cotiza por WhatsApp</a>
        <a class="sello" href={marca.instagram} target="_blank" rel="noopener">{marca.instagramHandle}</a>
      </div>
      <p class="contact-note">Cuéntanos qué espacio quieres transformar. Te respondemos directamente desde el equipo.</p>
    </div>
  </div>
</section>
