---
import '@fontsource/saira-semi-condensed/600.css';
import '@fontsource/saira-semi-condensed/700.css';
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/500.css';
import '@fontsource/fragment-mono/400.css';
import '../styles/global.css';
import ServiceRibbon from '../components/ServiceRibbon.astro';
import ServiciosIntegrales from '../components/ServiciosIntegrales.astro';
import Proceso from '../components/Proceso.astro';
import Indicadores from '../components/Indicadores.astro';
import Proyectos from '../components/Proyectos.astro';
import Instagram from '../components/Instagram.astro';
import Faq from '../components/Faq.astro';
import Nosotros from '../components/Nosotros.astro';
import Cotizador from '../components/Cotizador.astro';
import Contacto from '../components/Contacto.astro';
import { waLink, marca, whatsapp } from '../data/sitio';

const waUrl = waLink();
const title = 'Mobi Arquitectura | Carpintería, Diseño y Obra Civil en Barranquilla';
const description =
  'Carpintería arquitectónica, diseño de mobiliario, obra civil y acabados en Barranquilla, Colombia. Un solo equipo para llevar tu idea a la realidad.';
// Absolute URLs need `site` in astro.config.mjs (🔶 dominio pendiente).
const site = Astro.site;
const abs = (path: string) => (site ? new URL(path, site).href : path);
const ogImage = abs('/og.jpg');
const posterDesktop = '/seq/desktop/f-001.webp';
const posterMobile = '/seq/mobile/f-001.webp';
const finalFrame = '/seq/desktop/f-300.webp';
const heroWords = ['El', 'plano', 'cobra'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: marca.nombre,
  description,
  image: ogImage,
  ...(site ? { url: site.href } : {}),
  telephone: `+${whatsapp.numero}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Barranquilla', addressCountry: 'CO' },
  areaServed: { '@type': 'City', name: 'Barranquilla' },
  sameAs: [marca.instagram],
};
---

<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site && <link rel="canonical" href={site.href} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {site && <meta property="og:url" content={site.href} />}
    <meta property="og:site_name" content={marca.nombre} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Interior de madera y concreto con luz natural, terminado" />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f4f0e6" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={posterDesktop} as="image" type="image/webp" fetchpriority="high" media="(min-width: 701px)" />
    <link rel="preload" href={posterMobile} as="image" type="image/webp" fetchpriority="high" media="(max-width: 700px)" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>

    <header class="cajetin cajetin--clean" id="siteNav">
      <a class="brand" href="#inicio">
        <b>MOBI</b>
        <span>ARQUITECTURA</span>
      </a>
      <nav aria-label="Secciones">
        <a href="#servicios">Servicios</a>
        <a href="#proyectos">Proyectos</a>
        <a href="#cotizador">Cotizador</a>
        <a href="#contacto">Contacto</a>
      </nav>
      <div class="nav-actions">
        <a class="sello sello-nav" href={waUrl} target="_blank" rel="noopener" aria-label="Cotiza por WhatsApp">
          Cotiza por WhatsApp
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="menuPanel" aria-label="Abrir menú de secciones">
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <div class="menu-panel" id="menuPanel" hidden>
      <nav aria-label="Índice de secciones">
        <a href="#servicios"><b>01</b>Servicios integrales</a>
        <a href="#metodo"><b>02</b>Método de trabajo</a>
        <a href="#proyectos"><b>04</b>Proyectos</a>
        <a href="#faq"><b>06</b>Preguntas frecuentes</a>
        <a href="#cotizador"><b>08</b>Cotización rápida</a>
        <a href="#contacto"><b>—</b>Contacto</a>
      </nav>
    </div>

    <main id="contenido">
      <section class="hero" id="inicio" aria-label="El plano cobra vida">
        <div class="hero-stage">
          <picture>
            <source media="(max-width: 700px)" srcset={posterMobile} width="720" height="960" />
            <img
              id="heroPoster"
              class="hero-poster"
              src={posterDesktop}
              width="1920"
              height="1080"
              alt=""
              aria-hidden="true"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
          <canvas
            id="scrub"
            class="hero-canvas"
            role="img"
             aria-label="Secuencia de 300 cuadros: un plano arquitectónico cobra vida hasta volverse un interior de madera y concreto terminado"
          ></canvas>
          <img
            id="heroFallback"
            class="hero-fallback"
            alt="Interior de madera y concreto con luz natural, terminado"
          />
          <noscript>
            <img class="hero-noscript" src={finalFrame} alt="Interior de madera y concreto con luz natural, terminado" />
          </noscript>

          <div class="hero-intro" id="heroIntro">
            <p class="hero-eyebrow">CARPINTERÍA · DISEÑO · OBRA CIVIL — BARRANQUILLA</p>
            <h1 class="hero-title">
              {heroWords.map((w, i) => <><span class="w" style={`--i:${i}`}><span>{w}</span></span>{" "}</>)}
              <span class="w" style={`--i:${heroWords.length}`}><span><em class="vida">vida</em>.</span></span>
            </h1>
            <p class="hero-sub">Diseñamos, construimos y fabricamos cada espacio con un solo equipo.</p>
          </div>

          <div class="hero-hud" id="heroHud">
            <p class="hud-hint">DESLIZA PARA CONSTRUIR ↓</p>
            <div class="hud-ruler" aria-hidden="true"><span></span></div>
            <p class="hud-count" id="frameCount">F 001/300</p>
          </div>
          <p class="hero-status" id="heroStatus" role="status" aria-live="polite">CARGANDO SECUENCIA · 300 CUADROS</p>
          <div class="hero-side" aria-hidden="true">
            <span>V.01 — PLANO → ESPACIO</span>
          </div>
        </div>
        <div class="hero-bridge" id="heroBridge">
          <div class="bridge-inner">
            <p class="bridge-kicker">El siguiente trazo es tuyo</p>
            <h2>Hagamos que tu espacio cobre vida.</h2>
            <div class="bridge-actions">
              <a class="sello sello-big" href={waUrl} target="_blank" rel="noopener">Hablemos por WhatsApp</a>
              <a class="bridge-link" href={marca.instagram} target="_blank" rel="noopener">Ver nuestro trabajo <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </section>

       <ServiceRibbon />
       <ServiciosIntegrales />
       <Proceso />
       <Indicadores />
       <Proyectos />
       <Instagram />
       <Faq />
       <Nosotros />
       <Cotizador />
       <Contacto />
    </main>

    <footer class="pie">
      <div class="wrap pie-in">
        <a class="pie-brand" href="#inicio" aria-label="Volver al inicio">
          <strong>MOBI</strong>
          <span>ARQUITECTURA</span>
        </a>
        <nav class="pie-links" aria-label="Enlaces del pie de página">
          <a href="#servicios">Servicios</a>
          <a href="#proyectos">Proyectos</a>
          <a href="#cotizador">Cotizador</a>
          <a href={marca.instagram} target="_blank" rel="noopener">Instagram</a>
          <a href="#contacto">Contacto</a>
        </nav>
        <div class="pie-meta">
          <span>Barranquilla, Colombia</span>
          <span>© 2026 Mobi Arquitectura</span>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/hero-sequence';
      import '../scripts/nav';
      import '../scripts/motion';
    </script>
</body>
</html>

