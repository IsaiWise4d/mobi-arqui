---
import '@fontsource/saira-semi-condensed/600.css';
import '@fontsource/saira-semi-condensed/700.css';
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/500.css';
import '@fontsource/fragment-mono/400.css';
import '../styles/global.css';
import ServiceRibbon from '../components/ServiceRibbon.astro';
import Servicios from '../components/Servicios.astro';
import ServiciosCarousel from '../components/ServiciosCarousel.astro';
import Proceso from '../components/Proceso.astro';
import Portafolio from '../components/Portafolio.astro';
import Instagram from '../components/Instagram.astro';
import Contacto from '../components/Contacto.astro';

const igUrl = 'https://instagram.com/mobi_arquitectura';
const waUrl = `https://wa.me/573104063602?text=${encodeURIComponent('Hola, encontré Mobi Arquitectura en su sitio web y me gustaría cotizar un proyecto.')}`;
---

<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mobi Arquitectura · El plano cobra vida</title>
    <meta
      name="description"
      content="Carpintería arquitectónica, diseño de mobiliario, obra civil y acabados en Barranquilla, Colombia. Un solo equipo para llevar tu idea a la realidad."
    />
    <meta name="theme-color" content="#f4f0e6" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/frames/ezgif-frame-001.jpg" as="image" fetchpriority="high" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>

    <header class="cajetin cajetin--clean" id="siteNav">
      <a class="brand" href="#inicio">
        <b>MOBI</b>
        <span>ARQUITECTURA</span>
      </a>
      <nav aria-label="Secciones">
        <a href="#servicios">Servicios</a>
        <a href="#portafolio">Portafolio</a>
        <a href="#contacto">Contacto</a>
      </nav>
      <a class="sello sello-nav" href={waUrl} target="_blank" rel="noopener" aria-label="Cotiza por WhatsApp">
        Cotiza por WhatsApp
      </a>
    </header>

    <main id="contenido">
      <section class="hero" id="inicio" aria-label="El plano cobra vida">
        <div class="hero-stage">
          <canvas
            id="scrub"
            class="hero-canvas"
            role="img"
             aria-label="Secuencia de 300 cuadros: un plano arquitectónico cobra vida hasta volverse un interior de madera y concreto terminado"
          ></canvas>
          <img
            id="heroFallback"
            class="hero-fallback"
             src="/frames/ezgif-frame-300.jpg"
            alt="Interior de madera y concreto con luz natural, terminado"
          />
          <noscript>
            <img class="hero-noscript" src="/frames/ezgif-frame-300.jpg" alt="Interior de madera y concreto con luz natural, terminado" />
          </noscript>

          <div class="hero-intro" id="heroIntro">
            <h1 class="hero-title">El plano cobra <em class="vida">vida</em>.</h1>
            <p class="hero-sub">Diseñamos, construimos y fabricamos cada espacio con un solo equipo.</p>
          </div>

          <div class="hero-hud" id="heroHud">
            <p class="hud-hint">DESLIZA PARA CONSTRUIR ↓</p>
           <p class="hud-count" id="frameCount">F 001/300</p>
          </div>
           <p class="hero-status" id="heroStatus" role="status" aria-live="polite">CARGANDO SECUENCIA · 300 CUADROS</p>
          <div class="hero-side" aria-hidden="true">
            <span>V.01 — PLANO → ESPACIO</span>
          </div>
        </div>
        <div class="hero-bridge" id="heroBridge">
          <div class="bridge-inner">
            <p class="bridge-kicker">El siguiente trazo es tuyo</p>
            <h2>Hagamos que tu espacio cobre vida.</h2>
            <div class="bridge-actions">
              <a class="sello sello-big" href={waUrl} target="_blank" rel="noopener">Hablemos por WhatsApp</a>
              <a class="bridge-link" href={igUrl} target="_blank" rel="noopener">Ver nuestro trabajo <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </section>

       <ServiceRibbon />
       <Servicios />
       <ServiciosCarousel />
       <Proceso />
       <Portafolio />
       <Instagram />
       <Contacto />
    </main>

    <footer class="pie">
      <div class="wrap pie-in">
        <a class="pie-brand" href="#inicio" aria-label="Volver al inicio">
          <strong>MOBI</strong>
          <span>ARQUITECTURA</span>
        </a>
        <nav class="pie-links" aria-label="Enlaces del pie de página">
          <a href="#servicios">Servicios</a>
          <a href="#portafolio">Portafolio</a>
          <a href={igUrl} target="_blank" rel="noopener">Instagram</a>
          <a href="#contacto">Contacto</a>
        </nav>
        <div class="pie-meta">
          <span>Barranquilla, Colombia</span>
          <span>© 2026 Mobi Arquitectura</span>
        </div>
      </div>
    </footer>

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import EmblaCarousel from 'embla-carousel';
      import Autoplay from 'embla-carousel-autoplay';

      gsap.registerPlugin(ScrollTrigger);
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function setupCarousel() {
        const root = document.querySelector('[data-carousel]');
        if (!root) return;
        const viewport = root.querySelector('.embla__viewport');
        const previous = root.querySelector('[data-carousel-prev]');
        const next = root.querySelector('[data-carousel-next]');
        const current = root.querySelector('[data-carousel-current]');
        const progress = root.querySelector('.carousel-progress span');
        const autoplay = reducedMotion ? null : Autoplay({ delay: 4600, stopOnInteraction: false, stopOnMouseEnter: true });
        const embla = EmblaCarousel(viewport, { loop: true, align: 'start', duration: 35 }, autoplay ? [autoplay] : []);
        const slides = root.querySelectorAll('.service-slide');

        const update = () => {
          const index = embla.selectedScrollSnap();
          current.textContent = String(index + 1).padStart(2, '0');
          progress.style.transform = `scaleX(${(index + 1) / slides.length})`;
          slides.forEach((slide, slideIndex) => {
            const isCurrent = slideIndex === index;
            slide.setAttribute('aria-hidden', String(!isCurrent));
            slide.inert = !isCurrent;
          });
          if (!reducedMotion) {
            gsap.fromTo(slides[index].querySelectorAll('.service-copy > *'), { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: .52, stagger: .06, ease: 'power2.out', overwrite: true });
          }
        };

        previous.addEventListener('click', () => embla.scrollPrev());
        next.addEventListener('click', () => embla.scrollNext());
        embla.on('select', update);
        embla.on('init', update);
        update();
      }

      function setupMotion() {
        if (reducedMotion) {
          document.documentElement.classList.add('motion-reduced');
          return;
        }

        gsap.utils.toArray('.reveal').forEach((element) => {
          gsap.fromTo(element, { opacity: 0, y: 28, filter: 'blur(4px)' }, {
            opacity: 1,
            y: 0,
            filter: 'blur(0px)',
            duration: .72,
            ease: 'power3.out',
            scrollTrigger: { trigger: element, start: 'top 86%', toggleActions: 'play none none reverse' },
          });
        });

        gsap.utils.toArray('[data-gsap="section-head"] h2').forEach((title) => {
          gsap.fromTo(title, { clipPath: 'inset(0 0 100% 0)', y: 18 }, {
            clipPath: 'inset(0 0 0% 0)', y: 0, duration: .85, ease: 'power4.out',
            scrollTrigger: { trigger: title, start: 'top 82%', toggleActions: 'play none none reverse' },
          });
        });

        gsap.fromTo('.stations .station', { y: 34, rotateX: 5, opacity: 0 }, {
          y: 0, rotateX: 0, opacity: 1, duration: .7, stagger: .12, ease: 'power3.out',
          scrollTrigger: { trigger: '.stations', start: 'top 78%', toggleActions: 'play none none reverse' },
        });

        gsap.fromTo('.process-line span', { height: 0 }, {
          height: '100%', ease: 'none',
          scrollTrigger: { trigger: '.process-timeline', start: 'top 72%', end: 'bottom 78%', scrub: true },
        });

        gsap.fromTo('.phone', { rotateY: -14, rotateZ: 0, y: 36, opacity: 0 }, {
          rotateY: 0, rotateZ: 0, y: 0, opacity: 1, duration: 1.05, ease: 'power3.out',
          scrollTrigger: { trigger: '.phone-wrap', start: 'top 78%', toggleActions: 'play none none reverse' },
        });
        gsap.fromTo('.ig-grid img', { opacity: 0, scale: .86 }, {
          opacity: 1, scale: 1, duration: .45, stagger: .07, ease: 'power2.out',
          scrollTrigger: { trigger: '.ig-grid', start: 'top 84%', toggleActions: 'play none none reverse' },
        });

        gsap.fromTo('.contact-title', { clipPath: 'inset(0 0 100% 0)', y: 30 }, {
          clipPath: 'inset(0 0 0% 0)', y: 0, duration: .95, ease: 'power4.out',
          scrollTrigger: { trigger: '.contact-panel', start: 'top 76%', toggleActions: 'play none none reverse' },
        });
      }

      setupCarousel();
      setupMotion();
    </script>

    <script>
       const COUNT = 300;
       const pad = (n) => String(n).padStart(3, '0');
       const src = (n) => `/frames/ezgif-frame-${pad(n)}.jpg`;

      const canvas = document.getElementById('scrub');
      const stage = canvas.parentElement;
      const counter = document.getElementById('frameCount');
      const intro = document.getElementById('heroIntro');
       const hud = document.getElementById('heroHud');
       const bridge = document.getElementById('heroBridge');
      const status = document.getElementById('heroStatus');
      const fallback = document.getElementById('heroFallback');
       const hero = document.getElementById('inicio');
       const siteNav = document.getElementById('siteNav');
       const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
       const mobileViewport = window.matchMedia('(max-width: 700px)').matches;
       const ctx = canvas.getContext('2d');
      const frames = new Array(COUNT).fill(null);
      let drawn = -1;
      let target = reduced ? COUNT - 1 : 0;
      let displayTarget = target;
      let running = true;
      let loaded = 0;
      let failed = 0;

       function frameBounds(n) {
         const base = Math.max(0, Math.min(COUNT - 1, Math.floor(n)));
         let before = base;
         let after = base;
         while (before >= 0 && !frames[before]) before--;
         while (after < COUNT && !frames[after]) after++;
         if (before < 0 && after >= COUNT) return null;
         if (before < 0) before = after;
         if (after >= COUNT) after = before;
         return { before, after };
       }

       function paintFrame(image, alpha) {
         const w = canvas.width;
         const h = canvas.height;
         const naturalWidth = image.naturalWidth || image.width;
         const naturalHeight = image.naturalHeight || image.height;
         const s = Math.max(w / naturalWidth, h / naturalHeight);
         ctx.globalAlpha = alpha;
         ctx.drawImage(image, (w - naturalWidth * s) / 2, (h - naturalHeight * s) / 2, naturalWidth * s, naturalHeight * s);
       }

       function draw(n) {
         const bounds = frameBounds(n);
         if (!bounds) return;
         const { before, after } = bounds;
         const blend = before === after ? 0 : (n - before) / (after - before);
         ctx.clearRect(0, 0, canvas.width, canvas.height);
         ctx.imageSmoothingEnabled = true;
         paintFrame(frames[before], 1 - blend);
         if (after !== before) paintFrame(frames[after], blend);
         ctx.globalAlpha = 1;
         drawn = n;
         if (counter) counter.textContent = `F ${pad(Math.round(n) + 1)}/300`;
        if (status) status.textContent = reduced ? 'VISTA FINAL · MOVIMIENTO REDUCIDO' : 'SECUENCIA ACTIVA · DESLIZA PARA CONSTRUIR';
      }

       function sizeCanvas() {
         const dpr = mobileViewport ? 1 : Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.max(1, Math.round(stage.clientWidth * dpr));
        canvas.height = Math.max(1, Math.round(stage.clientHeight * dpr));
        drawn = -1;
        draw(target);
      }

      function loadBatch(indices) {
        let k = 0;
        const step = () => {
          const end = Math.min(k + 8, indices.length);
          for (; k < end; k++) {
            const n = indices[k];
            const im = new Image();
             im.decoding = 'async';
             im.fetchPriority = mobileViewport && n % 3 === 0 ? 'high' : 'low';
             im.onload = async () => {
               try { await im.decode(); } catch {}
              frames[n] = im;
              loaded += 1;
              draw(displayTarget);
            };
            im.onerror = () => {
              failed += 1;
              if (status && loaded === 0 && failed >= 8) {
                status.textContent = 'SECUENCIA NO DISPONIBLE · VISTA DE RESPALDO';
                fallback?.classList.add('is-visible');
              }
            };
            im.src = src(n + 1);
          }
          if (k < indices.length) setTimeout(step, 24);
        };
        step();
      }

       const order = [];
       const priorityStride = mobileViewport ? 3 : 5;
       for (let n = 0; n < COUNT; n += priorityStride) order.push(n);
       for (let n = 0; n < COUNT; n++) if (n % priorityStride !== 0) order.push(n);

      if (reduced) {
        document.documentElement.classList.add('static-hero');
        loadBatch([COUNT - 1]);
      } else {
        loadBatch(order);
      }

      function progress() {
        const total = hero.offsetHeight - window.innerHeight;
        if (total <= 0) return 0;
        return Math.min(1, Math.max(0, -hero.getBoundingClientRect().top / total));
      }

      function tick() {
        if (running && !reduced) {
          const p = progress();
          target = Math.round(p * (COUNT - 1));
          // Ease toward the scroll position so the canvas does not skip visibly on touch scroll.
          displayTarget += (target - displayTarget) * (mobileViewport ? 0.12 : 0.18);
          draw(displayTarget);
           if (intro && !reduced) {
             intro.classList.toggle('is-exiting', p > 0.28);
           }
           if (hud) hud.style.opacity = p > 0.93 ? '0' : '1';
           if (bridge) bridge.classList.toggle('is-ready', p > 0.84);
        }
        requestAnimationFrame(tick);
      }

      new ResizeObserver(sizeCanvas).observe(stage);
      sizeCanvas();
      new IntersectionObserver((entries) => {
        running = entries[0].isIntersecting;
      }).observe(hero);
      requestAnimationFrame(tick);

      let lastScrollY = window.scrollY;
      let scrollFrame = 0;
      function updateNav() {
        const currentY = window.scrollY;
        const delta = currentY - lastScrollY;
        if (siteNav) {
          siteNav.classList.toggle('is-scrolled', currentY > 24);
          if (currentY <= 24 || delta < -8 || document.activeElement?.closest('.cajetin')) {
            siteNav.classList.remove('is-hidden');
          } else if (delta > 8) {
            siteNav.classList.add('is-hidden');
          }
        }
        lastScrollY = currentY;
        scrollFrame = 0;
      }
      window.addEventListener('scroll', () => {
        if (!scrollFrame) scrollFrame = requestAnimationFrame(updateNav);
      }, { passive: true });
      siteNav?.addEventListener('focusin', () => siteNav.classList.remove('is-hidden'));

      const revealables = document.querySelectorAll('.reveal, .chain');
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.18 }
      );
      for (const el of revealables) io.observe(el);
    </script>
  <!-- impeccable-live-start -->
<script is:inline src="http://localhost:8400/live.js?token=bb8e8f4e-6798-4e01-b79b-f8504ddb034e"></script>
<!-- impeccable-live-end -->
</body>
</html>
