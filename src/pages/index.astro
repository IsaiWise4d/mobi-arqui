---
import '@fontsource/saira-semi-condensed/600.css';
import '@fontsource/saira-semi-condensed/700.css';
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/500.css';
import '@fontsource/fragment-mono/400.css';
import '../styles/global.css';

const igUrl = 'https://instagram.com/mobi_arquitectura';
const waUrl = `https://wa.me/573104063602?text=${encodeURIComponent('Hola, encontré Mobi Arquitectura en su sitio web y me gustaría cotizar un proyecto.')}`;
---

<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mobi Arquitectura · El plano cobra vida</title>
    <meta
      name="description"
      content="Carpintería arquitectónica, diseño de mobiliario, obra civil y acabados en Barranquilla, Colombia. Un solo equipo para llevar tu idea a la realidad."
    />
    <meta name="theme-color" content="#f4f0e6" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/frames/f_001.webp" as="image" fetchpriority="high" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>

    <header class="cajetin cajetin--clean" id="siteNav">
      <a class="brand" href="#inicio">
        <b>MOBI</b>
        <span>ARQUITECTURA</span>
      </a>
      <nav aria-label="Secciones">
        <a href="#servicios">Servicios</a>
        <a href="#portafolio">Portafolio</a>
        <a href="#contacto">Contacto</a>
      </nav>
      <a class="sello sello-nav" href={waUrl} target="_blank" rel="noopener" aria-label="Cotiza por WhatsApp">
        Cotiza por WhatsApp
      </a>
    </header>

    <main id="contenido">
      <section class="hero" id="inicio" aria-label="El plano cobra vida">
        <div class="hero-stage">
          <canvas
            id="scrub"
            class="hero-canvas"
            role="img"
            aria-label="Secuencia de 240 cuadros: un plano arquitectónico cobra vida hasta volverse un interior de madera y concreto terminado"
          ></canvas>
          <img
            id="heroFallback"
            class="hero-fallback"
            src="/frames/f_240.webp"
            alt="Interior de madera y concreto con luz natural, terminado"
          />
          <noscript>
            <img class="hero-noscript" src="/frames/f_240.webp" alt="Interior de madera y concreto con luz natural, terminado" />
          </noscript>

          <div class="hero-intro" id="heroIntro"><h1 class="hero-title">El plano cobra <em class="vida">vida</em>.</h1><p class="hero-sub">Un solo equipo responsable: el mismo estudio que dibuja ejecuta la obra y fabrica la carpintería.</p><div class="hero-cta"><a class="sello sello-big" href={waUrl} target="_blank" rel="noopener">Cotiza por WhatsApp</a><p class="hero-note">WhatsApp · respuesta directa · <a href={igUrl} target="_blank" rel="noopener">@mobi_arquitectura ↗</a></p></div></div>

          <div class="hero-hud" id="heroHud">
            <p class="hud-hint">DESLIZA PARA CONSTRUIR ↓</p>
            <p class="hud-count" id="frameCount">F 001/240</p>
          </div>
          <p class="hero-status" id="heroStatus" role="status" aria-live="polite">CARGANDO SECUENCIA · 240 CUADROS</p>
          <div class="hero-side" aria-hidden="true">
            <span>V.01 — PLANO → ESPACIO</span>
          </div>
        </div>
      </section>

      <section class="sec chain" id="servicios">
        <div class="wrap">
          <div class="sec-head reveal">
             <h2 class="sec-title">Del plano al mueble, sin cambiar de manos.</h2>
          </div>
          <div class="chain-dim" aria-hidden="true">
            <p class="dim-label">Un solo responsable</p>
            <div class="dim-line"></div>
          </div>
          <div class="stations">
            <div class="station reveal">
              <p class="station-no">01 / DISEÑO</p>
              <h3>Arquitectura y diseño</h3>
              <p>El anteproyecto y el diseño de espacios nacen aquí: distribución, luz y función en cada metro.</p>
            </div>
            <div class="station reveal">
              <p class="station-no">02 / OBRA</p>
              <h3>Obra civil</h3>
              <p>La obra se ejecuta con el mismo equipo que dibujó el plano, del albañil al acabado.</p>
            </div>
            <div class="station reveal">
              <p class="station-no">03 / CARPINTERÍA</p>
              <h3>Mueble a medida</h3>
              <p>La carpintería se fabrica en taller propio y se instala como parte del mismo proyecto.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="sec" aria-label="Índice de planos">
        <div class="wrap">
          <div class="sec-head reveal">
             <h2 class="sec-title">Qué construimos.</h2>
          </div>
           <div class="rows">
             <div class="row reveal">
               <p class="row-code">A-01</p>
               <p class="row-name">Carpintería arquitectónica</p>
               <p class="row-desc">Diseñamos y fabricamos soluciones a medida para cada espacio.</p>
             </div>
             <div class="row reveal">
               <p class="row-code">D-02</p>
               <p class="row-name">Asesorías de diseño de mobiliario</p>
               <p class="row-desc">Convertimos tus ideas en propuestas funcionales y bien resueltas.</p>
             </div>
             <div class="row reveal">
               <p class="row-code">C-03</p>
               <p class="row-name">Obra civil y acabados</p>
               <p class="row-desc">Ejecutamos la obra y cuidamos cada detalle hasta la entrega.</p>
             </div>
             <div class="row reveal">
               <p class="row-code">O-04</p>
               <p class="row-name">Divisiones de baño en vidrio templado</p>
               <p class="row-desc">Suministro e instalación para completar el espacio con precisión.</p>
             </div>
           </div>
           <p class="rows-note">* Cotización personalizada, sin precios de lista.</p>
         </div>
       </section>

       <section class="sec" aria-label="Nuestro proceso">
         <div class="wrap">
           <div class="sec-head reveal">
             <h2 class="sec-title">Nuestro proceso.</h2>
           </div>
           <div class="rows process-rows">
             <div class="row reveal">
               <p class="row-code">01</p>
               <p class="row-name">Escuchamos tu idea</p>
               <p class="row-desc">Entendemos lo que necesitas y cómo quieres vivir el espacio.</p>
             </div>
             <div class="row reveal">
               <p class="row-code">02</p>
               <p class="row-name">Diseñamos la propuesta</p>
               <p class="row-desc">Damos forma al proyecto con una solución clara y a tu medida.</p>
             </div>
             <div class="row reveal">
               <p class="row-code">03</p>
               <p class="row-name">Fabricamos a detalle</p>
               <p class="row-desc">Producimos cada elemento con cuidado, materialidad y precisión.</p>
             </div>
             <div class="row reveal">
               <p class="row-code">04</p>
               <p class="row-name">Instalamos y damos vida al proyecto</p>
               <p class="row-desc">Coordinamos la instalación para entregarte el resultado terminado.</p>
             </div>
           </div>
         </div>
       </section>

      <section class="sec" id="portafolio">
        <div class="wrap">
          <div class="sec-head reveal">
             <h2 class="sec-title">Obra real, en camino.</h2>
          </div>
          <div class="plot reveal">
            <p class="plot-coord tl">0,0</p>
            <p class="plot-coord tr">16,0</p>
            <p class="plot-coord bl">0,9</p>
            <p class="plot-coord br">16,9</p>
            <p class="stamp">En levantamiento</p>
          </div>
          <p class="plot-note reveal">
            Esta sección se llenará con fotos reales de obra, apenas salgan del taller. Aún no hay proyectos
            publicados y no los vamos a inventar: el héroe de arriba es el mejor vistazo a lo que hacemos.
          </p>
        </div>
      </section>

      <section class="sec" id="contacto">
        <div class="wrap">
          <div class="sec-head reveal">
             <h2 class="sec-title">¿Tienes un espacio en mente?</h2>
          </div>
          <div class="reveal">
             <p class="contact-line">Barranquilla, Colombia · WhatsApp directo, sin formularios</p>
            <div class="contact-actions">
               <a class="sello" href={waUrl} target="_blank" rel="noopener" aria-label="Cotiza por WhatsApp">
                <svg viewBox="0 0 448 512" width="15" height="17" fill="currentColor" aria-hidden="true">
                  <path
                    d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.1-29.4-27.7-63.3-27.7-98.1 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.7 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
                  ></path>
                </svg>
                Cotiza por WhatsApp
               </a>
              <a class="sello" href={igUrl} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                  <circle cx="12" cy="12" r="4.2"></circle>
                  <circle cx="17.3" cy="6.7" r="1.4" fill="currentColor" stroke="none"></circle>
                </svg>
                @mobi_arquitectura
              </a>
            </div>
            <p class="contact-note" style="margin-top: 22px">
               Escríbenos por WhatsApp y cuéntanos qué espacio quieres transformar. Te respondemos directamente desde el equipo.
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer class="pie">
      <div class="wrap pie-in">
        <span>Proyecto: Mobi Arquitectura</span>
        <span>Barranquilla, Colombia</span>
        <span>Lámina: L-01</span>
        <span>Escala: 1:1</span>
        <span>Rev: 00</span>
        <a href={igUrl} target="_blank" rel="noopener">IG: @mobi_arquitectura</a>
        <span>© 2026 Mobi Arquitectura</span>
      </div>
    </footer>

    <script>
      const COUNT = 240;
      const pad = (n) => String(n).padStart(3, '0');
      const src = (n) => `/frames/f_${pad(n)}.webp`;

      const canvas = document.getElementById('scrub');
      const stage = canvas.parentElement;
      const counter = document.getElementById('frameCount');
      const intro = document.getElementById('heroIntro');
      const hud = document.getElementById('heroHud');
      const status = document.getElementById('heroStatus');
      const fallback = document.getElementById('heroFallback');
      const hero = document.getElementById('inicio');
      const siteNav = document.getElementById('siteNav');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const ctx = canvas.getContext('2d');
      const frames = new Array(COUNT).fill(null);
      let drawn = -1;
      let target = reduced ? COUNT - 1 : 0;
      let displayTarget = target;
      let running = true;
      let loaded = 0;
      let failed = 0;

      function draw(n) {
        let i = n;
        while (i > 0 && !frames[i]) i--;
        if (!frames[i] || i === drawn) return;
        drawn = i;
        const w = canvas.width;
        const h = canvas.height;
        const s = Math.max(w / frames[i].naturalWidth, h / frames[i].naturalHeight);
        ctx.drawImage(
          frames[i],
          (w - frames[i].naturalWidth * s) / 2,
          (h - frames[i].naturalHeight * s) / 2,
          frames[i].naturalWidth * s,
          frames[i].naturalHeight * s
        );
        if (counter) counter.textContent = `F ${pad(i + 1)}/240`;
        if (status) status.textContent = reduced ? 'VISTA FINAL · MOVIMIENTO REDUCIDO' : 'SECUENCIA ACTIVA · DESLIZA PARA CONSTRUIR';
      }

      function sizeCanvas() {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.max(1, Math.round(stage.clientWidth * dpr));
        canvas.height = Math.max(1, Math.round(stage.clientHeight * dpr));
        drawn = -1;
        draw(target);
      }

      function loadBatch(indices) {
        let k = 0;
        const step = () => {
          const end = Math.min(k + 8, indices.length);
          for (; k < end; k++) {
            const n = indices[k];
            const im = new Image();
            im.decoding = 'async';
            im.onload = () => {
              frames[n] = im;
              loaded += 1;
              draw(target);
            };
            im.onerror = () => {
              failed += 1;
              if (status && loaded === 0 && failed >= 8) {
                status.textContent = 'SECUENCIA NO DISPONIBLE · VISTA DE RESPALDO';
                fallback?.classList.add('is-visible');
              }
            };
            im.src = src(n + 1);
          }
          if (k < indices.length) setTimeout(step, 24);
        };
        step();
      }

      const order = [];
      for (let n = 0; n < COUNT; n += 5) order.push(n);
      for (let n = 0; n < COUNT; n++) if (n % 5 !== 0) order.push(n);

      if (reduced) {
        document.documentElement.classList.add('static-hero');
        loadBatch([COUNT - 1]);
      } else {
        loadBatch(order);
      }

      function progress() {
        const total = hero.offsetHeight - window.innerHeight;
        if (total <= 0) return 0;
        return Math.min(1, Math.max(0, -hero.getBoundingClientRect().top / total));
      }

      function tick() {
        if (running && !reduced) {
          const p = progress();
          target = Math.round(p * (COUNT - 1));
          // Ease toward the scroll position so late-loading frames do not create jumps.
          displayTarget += (target - displayTarget) * 0.18;
          draw(Math.round(displayTarget));
          if (intro && !reduced) {
            const fade = p < 0.3 ? 1 : p < 0.55 ? 1 - (p - 0.3) / 0.25 : 0;
            intro.style.opacity = String(fade);
          }
          if (hud) hud.style.opacity = p > 0.93 ? '0' : '1';
        }
        requestAnimationFrame(tick);
      }

      new ResizeObserver(sizeCanvas).observe(stage);
      sizeCanvas();
      new IntersectionObserver((entries) => {
        running = entries[0].isIntersecting;
      }).observe(hero);
      requestAnimationFrame(tick);

      let lastScrollY = window.scrollY;
      let scrollFrame = 0;
      function updateNav() {
        const currentY = window.scrollY;
        const delta = currentY - lastScrollY;
        if (siteNav) {
          siteNav.classList.toggle('is-scrolled', currentY > 24);
          if (currentY <= 24 || delta < -8 || document.activeElement?.closest('.cajetin')) {
            siteNav.classList.remove('is-hidden');
          } else if (delta > 8) {
            siteNav.classList.add('is-hidden');
          }
        }
        lastScrollY = currentY;
        scrollFrame = 0;
      }
      window.addEventListener('scroll', () => {
        if (!scrollFrame) scrollFrame = requestAnimationFrame(updateNav);
      }, { passive: true });
      siteNav?.addEventListener('focusin', () => siteNav.classList.remove('is-hidden'));

      const revealables = document.querySelectorAll('.reveal, .chain');
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.18 }
      );
      for (const el of revealables) io.observe(el);
    </script>
  <!-- impeccable-live-start -->
<script is:inline src="http://localhost:8400/live.js?token=bb8e8f4e-6798-4e01-b79b-f8504ddb034e"></script>
<!-- impeccable-live-end -->
</body>
</html>
